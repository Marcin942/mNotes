<?xml version="1.0" encoding="utf-8"?>
<!-- Wersja debug: `ui-tooling` dokłada wyeksportowaną PreviewActivity, którą każda aplikacja może uruchomić z nazwą
     funkcji @Composable (wykona się w procesie mNotes, poza blokadą). Podglądów na urządzeniu nie używamy. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            tools:node="remove" />
    </application>
</manifest>
